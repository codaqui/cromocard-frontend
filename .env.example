# Copie para .env e ajuste. Valores só para o ambiente local.
# Em homologação e produção a URL da API vem do container (public/env.js), não deste arquivo.
VITE_API_URL=http://localhost:3000

# Access token de desenvolvimento, usado só no "npm run dev" enquanto o backend não tem /auth.
# Como gerar: README.md, seção "Sessão de desenvolvimento".
VITE_DEV_ACCESS_TOKEN=
