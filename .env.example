# Copie para .env e ajuste. Valores só para o ambiente local.
# Em homologação e produção estas URLs vêm do container (public/env.js), não deste arquivo.
VITE_API_URL=http://localhost:3000

# Client ID do Google Identity Services (o mesmo GOOGLE_CLIENT_ID do backend). Vazio esconde o botão do Google.
VITE_GOOGLE_CLIENT_ID=
