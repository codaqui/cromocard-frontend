# Copie para .env e ajuste. Valores só para o ambiente local.
# Em homologação e produção estas URLs vêm do container (public/env.js), não deste arquivo.
VITE_API_URL=http://localhost:3000
# Tempo real (Socket.IO): o processo ws do backend (PORT=3001 npm run dev:ws)
VITE_WS_URL=http://localhost:3001

# Client ID do Google Identity Services (o mesmo GOOGLE_CLIENT_ID do backend). Vazio esconde o botão do Google.
VITE_GOOGLE_CLIENT_ID=

# E-mail do suporte no "Enviar e-mail" da Central de ajuda. Vazio usa suporte@cromocard.dev.
VITE_SUPPORT_EMAIL=
